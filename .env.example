# 1. Supabase Project Configuration (Client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Supabase Administrative Keys (Server-side ONLY - NEVER expose to frontend!)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Notification and Anti-spam Configuration
ADMIN_NOTIFICATION_EMAIL=artist@dynex.archive
EMAIL_API_KEY=resend_or_postmark_api_key

# 4. Optional Cloudflare Turnstile CAPTCHA Site Key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
